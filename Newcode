# =========================================
# PASSWORD GENERATOR
# =========================================

function Generate-RandomPassword {

    param ([int]$Length = 15)

    $chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_-+=?"

    -join ((1..$Length) | ForEach-Object {
        $chars[(Get-Random -Maximum $chars.Length)]
    })
}

# =========================================
# CHECK ALIAS EXISTS
# =========================================

function Alias-Exists {

    param($Alias)

    $domains = @(
        "IN.COFORGETECH.COM",
        "UK.COFORGETECH.COM",
        "US.COFORGETECH.COM"
    )

    foreach ($domain in $domains) {

        $check = Get-ADUser `
            -Filter "SamAccountName -eq '$Alias'" `
            -Server $domain `
            -ErrorAction SilentlyContinue

        if ($check) {

            return $true
        }
    }

    return $false
}

# =========================================
# SMART ALIAS GENERATOR
# =========================================

function Get-UniqueAlias {

    param($FirstName, $LastName)

    $FirstName = $FirstName.Trim()
    $LastName  = $LastName.Trim()

    $FirstName = $FirstName.Replace(" ","")
    $LastName  = $LastName.Replace(" ","")

    $FirstName = $FirstName.ToLower()
    $LastName  = $LastName.ToLower()

    $maxAliasLength = 17

    # =========================================
    # CASE 1
    # firstname.lastname
    # =========================================

    if ($LastName) {

        $BaseAlias = "$FirstName.$LastName"

        if ($BaseAlias.Length -le $maxAliasLength) {

            if (-not (Alias-Exists $BaseAlias)) {

                return $BaseAlias
            }

            $count = 1

            while ($true) {

                $Alias = "$FirstName.$count.$LastName"

                if ($Alias.Length -le $maxAliasLength) {

                    if (-not (Alias-Exists $Alias)) {

                        return $Alias
                    }
                }

                $count++
            }
        }
    }

    # =========================================
    # CASE 2
    # firstname.l
    # =========================================

    if ($LastName) {

        $ShortLast = $LastName.Substring(0,1)

        $BaseAlias = "$FirstName.$ShortLast"

        if ($BaseAlias.Length -le $maxAliasLength) {

            if (-not (Alias-Exists $BaseAlias)) {

                return $BaseAlias
            }

            $count = 1

            while ($true) {

                $Alias = "$FirstName.$count.$ShortLast"

                if ($Alias.Length -le $maxAliasLength) {

                    if (-not (Alias-Exists $Alias)) {

                        return $Alias
                    }
                }

                $count++
            }
        }
    }

    # =========================================
    # CASE 3
    # COMPRESS LONG FIRSTNAME
    # =========================================

    $Compressed = ""

    $Words = $FirstName -split '(?=[A-Z])'

    if ($Words.Count -eq 1) {

        $Words = @()

        $temp = $FirstName

        while ($temp.Length -gt 0) {

            if ($temp.Length -gt 8) {

                $Words += $temp.Substring(0,8)

                $temp = $temp.Substring(8)
            }
            else {

                $Words += $temp
                break
            }
        }
    }

    foreach ($word in $Words) {

        if ($word.Length -gt 0) {

            $Compressed += $word.Substring(0,1).ToUpper()
        }
    }

    $Readable = $FirstName.Substring(0,[Math]::Min(12,$FirstName.Length))

    $BaseAlias = "$Readable$Compressed"

    if ($LastName) {

        $BaseAlias = "$BaseAlias.$($LastName.Substring(0,1))"
    }

    if ($BaseAlias.Length -gt $maxAliasLength) {

        $BaseAlias = $BaseAlias.Substring(0,$maxAliasLength)
    }

    if (-not (Alias-Exists $BaseAlias)) {

        return $BaseAlias
    }

    $count = 1

    while ($true) {

        if ($LastName) {

            $Alias = "$BaseAlias.$count.$($LastName.Substring(0,1))"
        }
        else {

            $Alias = "$BaseAlias.$count"
        }

        if ($Alias.Length -gt $maxAliasLength) {

            $Allowed = $maxAliasLength - ($count.ToString().Length + 2)

            $Alias = $Alias.Substring(0,$Allowed) + ".$count"
        }

        if (-not (Alias-Exists $Alias)) {

            return $Alias
        }

        $count++
    }
}

# =========================================
