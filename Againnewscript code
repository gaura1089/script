param(
    [string]$Mode,
    [string]$FirstName,
    [string]$LastName,
    [string]$DisplayName,
    [string]$OU
)

Import-Module ActiveDirectory

# =========================================
# EXCHANGE CREDENTIAL
# =========================================

$Cred = Import-Clixml "C:\Users\Gaurav.26\OneDrive - Coforge Limited\Documents\HR_Automation\Creds\ExchangeCred.xml"

# =========================================
# CONNECT TO EXCHANGE
# =========================================

Write-Host ""
Write-Host "========================================="
Write-Host "CONNECTING TO EXCHANGE"
Write-Host "========================================="
Write-Host ""

try {

    $Session = New-PSSession `
        -ConfigurationName Microsoft.Exchange `
        -ConnectionUri http://IN-TZ1-EXMBX2.in.coforgetech.com/PowerShell/ `
        -Authentication Kerberos `
        -Credential $Cred `
        -ErrorAction Stop

    Import-PSSession `
        $Session `
        -DisableNameChecking `
        -AllowClobber `
        -ErrorAction Stop | Out-Null

    Write-Host "Connected Successfully"
}
catch {

    Write-Host ""
    Write-Host "========================================="
    Write-Host "EXCHANGE CONNECTION FAILED"
    Write-Host "========================================="
    Write-Host ""

    Write-Host $_.Exception.Message

    Start-Sleep -Seconds 180
    exit
}

# =========================================
# PASSWORD GENERATOR
# =========================================

function Generate-RandomPassword {

    param ([int]$Length = 15)

    $chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_-+=?"

    -join ((1..$Length) | ForEach-Object {
        $chars[(Get-Random -Maximum $chars.Length)]
    })
}

# =========================================
# UNIQUE ALIAS GENERATOR
# =========================================

function Get-UniqueAlias {

    param($FirstName, $LastName)

    $domains = @(
        "IN.COFORGETECH.COM",
        "UK.COFORGETECH.COM",
        "US.COFORGETECH.COM"
    )

    function Get-ValidAlias($fn, $ln) {

        $domainLen = 13
        $max = 30 - $domainLen

        $base1 = "$fn.$ln"

        if ($base1.Length -le $max) {
            return $base1
        }

        $base2 = "$fn.$($ln.Substring(0,1))"

        if ($base2.Length -le $max) {
            return $base2
        }

        if ($fn.Length -le $max) {
            return $fn
        }

        return $fn.Substring(0,$max)
    }

    $baseAlias = Get-ValidAlias $FirstName $LastName

    $alias = $baseAlias
    $count = 1

    while ($true) {

        $found = $false

        foreach ($domain in $domains) {

            $check = Get-ADUser `
                -Filter "SamAccountName -eq '$alias'" `
                -Server $domain `
                -ErrorAction SilentlyContinue

            if ($check) {

                $found = $true
                break
            }
        }

        if (-not $found) {

            return $alias
        }

        $alias = "$($FirstName).$count.$($LastName)"

        if ($alias.Length -gt (30-13)) {

            $alias = Get-ValidAlias "$FirstName$count" $LastName
        }

        $count++
    }
}

# =========================================
# SINGLE USER MODE
# =========================================

if ($Mode -eq "Single") {

    Write-Host ""
    Write-Host "========================================="
    Write-Host "STARTING MAILBOX CREATION"
    Write-Host "========================================="
    Write-Host ""

    # =========================================
    # CLEAN OU VALUE
    # =========================================

    $OU = $OU.Trim().ToLower()

    # =========================================
    # OU MAPPING
    # =========================================

    switch ($OU) {

        "noidap1" {

            $OUPath = "OU=Users,OU=RestofCoforge,OU=GreaterNoidaP1,DC=IN,DC=COFORGETECH,DC=COM"
        }

        "noidap2" {

            $OUPath = "OU=Users,OU=RestofCoforge,OU=GreaterNoidaP2,DC=IN,DC=COFORGETECH,DC=COM"
        }

        "gurgaon" {

            $OUPath = "OU=Users,OU=RestofCoforge,OU=Gurugram,DC=IN,DC=COFORGETECH,DC=COM"
        }

        "hydrabad" {

            $OUPath = "OU=Users,OU=RestofCoforge,OU=Hyderabad,DC=IN,DC=COFORGETECH,DC=COM"
        }

        "banluru" {

            $OUPath = "OU=Users,OU=RestofCoforge,OU=Bengaluru,DC=IN,DC=COFORGETECH,DC=COM"
        }

        default {

            Write-Host ""
            Write-Host "INVALID OU"

            Start-Sleep -Seconds 180
            exit
        }
    }

    # =========================================
    # PASSWORD
    # =========================================

    $Password = Generate-RandomPassword

    $SecurePassword = ConvertTo-SecureString `
        $Password `
        -AsPlainText `
        -Force

    # =========================================
    # UNIQUE ALIAS
    # =========================================

    $Alias = Get-UniqueAlias $FirstName $LastName

    $UPN = "$Alias@coforge.com"

    $Routing = "$Alias@ntlgnoida.mail.onmicrosoft.com"

    Write-Host ""
    Write-Host "========================================="
    Write-Host "USER DETAILS"
    Write-Host "========================================="
    Write-Host ""

    Write-Host "First Name  : $FirstName"
    Write-Host "Last Name   : $LastName"
    Write-Host "DisplayName : $DisplayName"
    Write-Host "Alias       : $Alias"
    Write-Host "Email       : $UPN"
    Write-Host "OU          : $OU"

    try {

        # =========================================
        # CREATE REMOTE MAILBOX
        # =========================================

        New-RemoteMailbox `
            -Name $DisplayName `
            -FirstName $FirstName `
            -LastName $LastName `
            -Alias $Alias `
            -UserPrincipalName $UPN `
            -OnPremisesOrganizationalUnit $OUPath `
            -Password $SecurePassword `
            -ResetPasswordOnNextLogon $false `
            -RemoteRoutingAddress $Routing `
            -ErrorAction Stop

        Start-Sleep -Seconds 10

        # =========================================
        # SET PRIMARY SMTP
        # =========================================

        try {

            Set-RemoteMailbox `
                $UPN `
                -PrimarySmtpAddress $UPN `
                -ErrorAction Stop
        }
        catch {

            Write-Host ""
            Write-Host "SMTP UPDATE SKIPPED"
        }

        Write-Host ""
        Write-Host "========================================="
        Write-Host "MAILBOX CREATED SUCCESSFULLY"
        Write-Host "========================================="
        Write-Host ""

        # =========================================
        # LOG FOLDER
        # =========================================

        $LogFolder = "C:\Users\Gaurav.26\OneDrive - Coforge Limited\Documents\HR_Automation\Logs"

        if (!(Test-Path $LogFolder)) {

            New-Item `
                -ItemType Directory `
                -Path $LogFolder | Out-Null
        }

        # =========================================
        # SUCCESS CSV
        # =========================================

        $SafeName = $DisplayName.Replace(" ","_")

        $LogPath = "$LogFolder\$SafeName.csv"

        $Result = @()

        $Result += [PSCustomObject]@{

            DisplayName = $DisplayName
            Alias       = $Alias
            Email       = $UPN
            Password    = $Password
            Status      = "SUCCESS"
            OU          = $OU
        }

        $Result | Export-Csv `
            $LogPath `
            -NoTypeInformation `
            -Encoding UTF8

        Write-Host "Success Log Saved:"
        Write-Host $LogPath

        Start-Sleep -Seconds 5
    }

    catch {

        Write-Host ""
        Write-Host "========================================="
        Write-Host "MAILBOX CREATION FAILED"
        Write-Host "========================================="
        Write-Host ""

        $ErrorMessage = $_.Exception.Message

        Write-Host $ErrorMessage

        # =========================================
        # ERROR LOG FOLDER
        # =========================================

        $LogFolder = "C:\Users\Gaurav.26\OneDrive - Coforge Limited\Documents\HR_Automation\Logs"

        if (!(Test-Path $LogFolder)) {

            New-Item `
                -ItemType Directory `
                -Path $LogFolder | Out-Null
        }

        # =========================================
        # ERROR CSV
        # =========================================

        $SafeName = $DisplayName.Replace(" ","_")

        $ErrorLogPath = "$LogFolder\$SafeName`_ERROR.csv"

        $ErrorResult = @()

        $ErrorResult += [PSCustomObject]@{

            DisplayName = $DisplayName
            FirstName   = $FirstName
            LastName    = $LastName
            OU          = $OU
            Status      = "FAILED"
            Error       = $ErrorMessage
        }

        $ErrorResult | Export-Csv `
            $ErrorLogPath `
            -NoTypeInformation `
            -Encoding UTF8

        Write-Host ""
        Write-Host "Error Log Saved:"
        Write-Host $ErrorLogPath

        Write-Host ""
        Write-Host "WINDOW WILL CLOSE IN 3 MINUTES"

        Start-Sleep -Seconds 180
    }
}
else {

    Write-Host ""
    Write-Host "INVALID MODE"

    Start-Sleep -Seconds 180
}

# =========================================
# CLOSE EXCHANGE SESSION
# =========================================

if ($Session) {

    Remove-PSSession $Session
}
