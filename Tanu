# =========================================
# PASSWORD GENERATOR
# =========================================

function Generate-RandomPassword {

    param([int]$Length = 15)

    $chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_-+=?"

    -join ((1..$Length) | ForEach-Object {
        $chars[(Get-Random -Maximum $chars.Length)]
    })
}

# =========================================
# CHECK ALIAS EXISTS
# =========================================

function Alias-Exists {

    param($Alias)

    $domains = @(
        "IN.COFORGETECH.COM",
        "UK.COFORGETECH.COM",
        "US.COFORGETECH.COM"
    )

    foreach ($domain in $domains) {

        $check = Get-ADUser `
            -Filter "SamAccountName -eq '$Alias'" `
            -Server $domain `
            -ErrorAction SilentlyContinue

        if ($check) {

            return $true
        }
    }

    return $false
}

# =========================================
# UNIQUE ALIAS GENERATOR
# =========================================

function Get-UniqueAlias {

    param($FirstName, $LastName)

    $maxLength = 30

    $FirstName = ($FirstName -replace '\s','')
    $LastName  = ($LastName -replace '\s','')

    $FirstName = $FirstName.ToLower()
    $LastName  = $LastName.ToLower()

    function Get-NumberedAlias {

        param($Alias)

        if (-not (Alias-Exists $Alias)) {

            return $Alias
        }

        $count = 1

        while ($true) {

            if ($Alias.Contains(".")) {

                $parts = $Alias.Split(".")

                if ($parts.Count -eq 2) {

                    $newAlias = "$($parts[0]).$count.$($parts[1])"
                }
                else {

                    $newAlias = "$Alias.$count"
                }
            }
            else {

                $newAlias = "$Alias.$count"
            }

            if ($newAlias.Length -le $maxLength) {

                if (-not (Alias-Exists $newAlias)) {

                    return $newAlias
                }
            }

            $count++
        }
    }

    # =========================================
    # CASE 1
    # firstname.lastname
    # =========================================

    if ($LastName) {

        $alias = "$FirstName.$LastName"

        if ($alias.Length -le $maxLength) {

            return Get-NumberedAlias $alias
        }
    }

    # =========================================
    # CASE 2
    # firstname.l
    # =========================================

    if ($LastName) {

        $lastInitial = $LastName.Substring(0,1)

        $alias = "$FirstName.$lastInitial"

        if ($alias.Length -le $maxLength) {

            return Get-NumberedAlias $alias
        }
    }

    # =========================================
    # CASE 3
    # LONG FIRSTNAME
    # =========================================

    $chunks = @()

    $temp = $FirstName

    while ($temp.Length -gt 0) {

        if ($temp.Length -gt 8) {

            $chunks += $temp.Substring(0,8)

            $temp = $temp.Substring(8)
        }
        else {

            $chunks += $temp
            break
        }
    }

    $compressed = ""

    foreach ($c in $chunks) {

        $compressed += $c.Substring(0,1).ToUpper()
    }

    $readable = $FirstName.Substring(
        0,
        [Math]::Min(12,$FirstName.Length)
    )

    $newFirst = "$readable$compressed"

    if ($LastName) {

        $lastInitial = $LastName.Substring(0,1)

        $alias = "$newFirst.$lastInitial"
    }
    else {

        $alias = "$newFirst"
    }

    if ($alias.Length -gt $maxLength) {

        $alias = $alias.Substring(0,$maxLength)
    }

    return Get-NumberedAlias $alias
}

