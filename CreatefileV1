# =========================================
# PASSWORD GENERATOR
# =========================================

function Generate-RandomPassword {

    param([int]$Length = 15)

    $chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_-+=?"

    -join ((1..$Length) | ForEach-Object {

        $chars[(Get-Random -Maximum $chars.Length)]
    })
}

# =========================================
# CHECK ALIAS EXISTS
# =========================================

function Alias-Exists {

    param($Alias)

    $domains = @(
        "IN.COFORGETECH.COM",
        "UK.COFORGETECH.COM",
        "US.COFORGETECH.COM"
    )

    foreach ($domain in $domains) {

        $check = Get-ADUser `
            -Filter "SamAccountName -eq '$Alias'" `
            -Server $domain `
            -ErrorAction SilentlyContinue

        if ($check) {

            return $true
        }
    }

    return $false
}

# =========================================
# UNIQUE ALIAS
# =========================================

function Get-UniqueAlias {

    param($FirstName,$LastName)

    $maxLength = 30

    $FirstName = ($FirstName -replace '\s','').ToLower()
    $LastName  = ($LastName -replace '\s','').ToLower()

    function Get-AvailableAlias {

        param($BaseAlias)

        if (-not (Alias-Exists $BaseAlias)) {

            return $BaseAlias
        }

        $count = 1

        while ($true) {

            if ($BaseAlias.Contains(".")) {

                $parts = $BaseAlias.Split(".")

                if ($parts.Count -eq 2) {

                    $newAlias = "$($parts[0]).$count.$($parts[1])"
                }
                else {

                    $newAlias = "$BaseAlias.$count"
                }
            }
            else {

                $newAlias = "$BaseAlias.$count"
            }

            if ($newAlias.Length -le $maxLength) {

                if (-not (Alias-Exists $newAlias)) {

                    return $newAlias
                }
            }

            $count++
        }
    }

    # =====================================
    # CASE 1
    # firstname.lastname
    # =====================================

    if ($LastName) {

        $alias = "$FirstName.$LastName"

        if ($alias.Length -le $maxLength) {

            return Get-AvailableAlias $alias
        }
    }

    # =====================================
    # CASE 2
    # firstname.l
    # =====================================

    if ($LastName) {

        $lastInitial = $LastName.Substring(0,1)

        $alias = "$FirstName.$lastInitial"

        if ($alias.Length -le $maxLength) {

            return Get-AvailableAlias $alias
        }
    }

    # =====================================
    # CASE 3
    # compress firstname
    # =====================================

    $parts = @()

    $temp = $FirstName

    while ($temp.Length -gt 0) {

        if ($temp.Length -gt 8) {

            $parts += $temp.Substring(0,8)

            $temp = $temp.Substring(8)
        }
        else {

            $parts += $temp
            break
        }
    }

    $compressed = ""

    foreach ($p in $parts) {

        $compressed += $p.Substring(0,1).ToUpper()
    }

    $readable = $FirstName.Substring(
        0,
        [Math]::Min(12,$FirstName.Length)
    )

    $newFirst = "$readable$compressed"

    if ($LastName) {

        $lastInitial = $LastName.Substring(0,1)

        $alias = "$newFirst.$lastInitial"
    }
    else {

        $alias = "$newFirst"
    }

    if ($alias.Length -gt $maxLength) {

        $alias = $alias.Substring(0,$maxLength)
    }

    return Get-AvailableAlias $alias
}

