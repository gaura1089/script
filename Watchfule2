Write-Host "========================================="
Write-Host "CHECKING QUEUE FOLDER"
Write-Host "========================================="
Write-Host ""

# =========================================
# GET JSON FILES
# =========================================

$Files = Get-ChildItem "$QueuePath\*.json" -ErrorAction SilentlyContinue

foreach ($File in $Files) {

    try {

        Write-Host ""
        Write-Host "========================================="
        Write-Host "PROCESSING FILE"
