$queueFolder = `
"C:\Users\Gaurav.26\OneDrive - Coforge Limited\Documents\HR_Automation\Queue"

$processedFolder = `
"C:\Users\Gaurav.26\OneDrive - Coforge Limited\Documents\HR_Automation\Processed"

$createUserScript = `
"C:\Users\Gaurav.26\OneDrive - Coforge Limited\Documents\HR_Automation\Scripts\CreateUser.ps1"

Write-Host ""
Write-Host "=============================================" -ForegroundColor Cyan
Write-Host "HR AUTOMATION WATCHER STARTED" -ForegroundColor Green
Write-Host "=============================================" -ForegroundColor Cyan

# =========================================
# CHECK QUEUE
# =========================================

$jsonFiles = Get-ChildItem `
    -Path $queueFolder `
    -Filter *.json `
    -ErrorAction SilentlyContinue

if (!$jsonFiles -or $jsonFiles.Count -eq 0) {

    Write-Host ""
    Write-Host "NO JSON FILE FOUND IN QUEUE" -ForegroundColor Yellow

    Write-Host ""
    Write-Host "WATCHER WILL CLOSE IN 10 SECONDS..." -ForegroundColor Cyan

    Start-Sleep 10

    Get-Job | Stop-Job -ErrorAction SilentlyContinue
    Get-Job | Remove-Job -ErrorAction SilentlyContinue

    [System.Environment]::Exit(0)
}

# =========================================
# PROCESS EACH JSON
# =========================================

foreach ($jsonFile in $jsonFiles) {

    try {

        Write-Host ""
        Write-Host "=============================================" -ForegroundColor Cyan
        Write-Host "PROCESSING FILE: $($jsonFile.Name)" -ForegroundColor Green
        Write-Host "=============================================" -ForegroundColor Cyan

        # =========================================
        # READ JSON
        # =========================================

        $jsonData = Get-Content `
            $jsonFile.FullName `
            -Raw | ConvertFrom-Json

        $FirstName   = $jsonData.FirstName
        $LastName    = $jsonData.LastName
        $DisplayName = $jsonData.DisplayName
        $OU          = $jsonData.OU

        Write-Host ""
        Write-Host "USER DETAILS" -ForegroundColor Yellow
        Write-Host "---------------------------------------------"

        Write-Host "First Name  : $FirstName"
        Write-Host "Last Name   : $LastName"
        Write-Host "DisplayName : $DisplayName"
        Write-Host "OU          : $OU"

        Write-Host ""
        Write-Host "STARTING MAILBOX CREATION..." -ForegroundColor Yellow

        # =========================================
        # RUN CREATE USER SCRIPT
        # =========================================

        & $createUserScript `
            -Mode "Single" `
            -FirstName "$FirstName" `
            -LastName "$LastName" `
            -DisplayName "$DisplayName" `
            -OU "$OU"

        Write-Host ""
        Write-Host "MAILBOX SCRIPT EXECUTED" -ForegroundColor Green

        # =========================================
        # MOVE JSON TO PROCESSED
        # =========================================

        Move-Item `
            $jsonFile.FullName `
            "$processedFolder\$($jsonFile.Name)" `
            -Force

        Write-Host ""
        Write-Host "JSON MOVED TO PROCESSED" -ForegroundColor Green
    }
    catch {

        Write-Host ""
        Write-Host "=============================================" -ForegroundColor Red
        Write-Host "ERROR OCCURRED" -ForegroundColor Red
        Write-Host "=============================================" -ForegroundColor Red

        Write-Host ""
        Write-Host $_.Exception.Message -ForegroundColor Red
    }
}

# =========================================
# COMPLETE
# =========================================

Write-Host ""
Write-Host "=============================================" -ForegroundColor Cyan
Write-Host "PROCESS COMPLETED" -ForegroundColor Green
Write-Host "=============================================" -ForegroundColor Cyan

Write-Host ""
Write-Host "WATCHER WILL CLOSE IN 5 SECONDS..." -ForegroundColor Yellow

Start-Sleep 5

Get-Job | Stop-Job -ErrorAction SilentlyContinue
Get-Job | Remove-Job -ErrorAction SilentlyContinue

[System.Environment]::Exit(0)




