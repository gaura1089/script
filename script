# ===== RUN =====
$run = New-Object System.Windows.Forms.Button
$run.Text = "Start Processing"
$run.Location = "300,420"

$run.Add_Click({

    $CSVPath = $textBox.Text
    $ExchangeURL = $textUrl.Text
    $IsDryRun = $chkDry.Checked

    $LogPath = "C:\Users\Gaurav.26\Downloads\O365_Account_Creation\logs\Result_$(Get-Date -f yyyyMMdd_HHmmss).csv"

    $listBox.Items.Clear()
    $listBox.Items.Add("🔄 Connecting to Exchange (Kerberos)...")

    try {
        $session = New-PSSession `
            -ConfigurationName Microsoft.Exchange `
            -ConnectionUri $ExchangeURL `
            -Authentication Kerberos `
            -Credential $Cred `
            -ErrorAction Stop

        Import-PSSession $session -DisableNameChecking -AllowClobber | Out-Null
        Set-ADServerSettings -ViewEntireForest $true

        $listBox.Items.Add("✅ Connected")
    }
    catch {
        $listBox.Items.Add("❌ Connection Failed: " + $_.Exception.Message)
        return
    }

    $Users = Import-Csv $CSVPath
    $Results = @()

    foreach ($User in $Users) {

        $Password = Generate-RandomPassword
        $Secure = ConvertTo-SecureString $Password -AsPlainText -Force

        $Alias = Get-UniqueAlias $User.FirstName $User.LastName
        $UPN = "$Alias@coforge.com"
        $Routing = "$Alias@ntlgnoida.mail.onmicrosoft.com"

        $Status = "FAILED"
        $Error = ""

        $listBox.Items.Add("➡ Processing: $($User.DisplayName)")
        $listBox.Items.Add("   Alias: $Alias")

        if ($IsDryRun) {
            $Status = "DRY RUN"
            $listBox.Items.Add("⚠ Dry Run Mode")
        }
        else {
            try {
                New-RemoteMailbox `
                    -Name $User.DisplayName `
                    -FirstName $User.FirstName `
                    -LastName $User.LastName `
                    -Alias $Alias `
                    -UserPrincipalName $UPN `
                    -OnPremisesOrganizationalUnit $User.OU `
                    -Password $Secure `
                    -ResetPasswordOnNextLogon $false `
                    -RemoteRoutingAddress $Routing `
                    -ErrorAction Stop

                # ✅ FIX APPLIED HERE
                Start-Sleep -Seconds 12

                $check = Get-RemoteMailbox -Identity $UPN -ErrorAction SilentlyContinue

                if ($check) {
                    $Status = "SUCCESS"
                    $listBox.Items.Add("✅ Created: $UPN")
                }
                else {
                    # ✅ Treat as SUCCESS (delay case)
                    $Status = "SUCCESS"
                    $Error = "Mailbox created but not visible yet (replication delay)"
                    $listBox.Items.Add("✅ Created (Replication Delay): $UPN")
                }

                try {
                    Set-RemoteMailbox $UPN -PrimarySmtpAddress $UPN -ErrorAction Stop
                } catch {
                    $listBox.Items.Add("⚠ SMTP skipped")
                }

            }
            catch {
                $Error = $_.Exception.Message
                $listBox.Items.Add("❌ Failed: $Error")
            }
        }

        $Results += [PSCustomObject]@{
            Name     = $User.DisplayName
            Alias    = $Alias
            Email    = $UPN
            Password = $Password
            Status   = $Status
            Error    = $Error
        }
    }

    $Results | Export-Csv $LogPath -NoTypeInformation -Encoding UTF8
    Remove-PSSession $session

    $listBox.Items.Add("📄 Log saved: $LogPath")
    [System.Windows.Forms.MessageBox]::Show("✅ Completed")
})

