# ===== Password Generator =====
function Generate-RandomPassword {
    param ([int]$Length = 15)
    $chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_-+=?"
    -join ((1..$Length) | ForEach-Object { $chars[(Get-Random -Max $chars.Length)] })
}

# ===== Alias Generator =====
function Get-UniqueAlias {
    param($FirstName, $LastName)

    $domains = @("IN.COFORGETECH.COM","UK.COFORGETECH.COM","US.COFORGETECH.COM")

    function Get-ValidAlias($fn, $ln) {
        $domainLen = 13
        $max = 30 - $domainLen

        $base1 = "$fn.$ln"
        if ($base1.Length -le $max) { return $base1 }

        $base2 = "$fn.$($ln.Substring(0,1))"
        if ($base2.Length -le $max) { return $base2 }

        if ($fn.Length -le $max) { return $fn }

        return $fn.Substring(0,$max)
    }

    $baseAlias = Get-ValidAlias $FirstName $LastName
    $alias = $baseAlias
    $count = 1

    while ($true) {
        $found = $false

        foreach ($domain in $domains) {
            $check = Get-ADUser -Filter "SamAccountName -eq '$alias'" -Server $domain -ErrorAction SilentlyContinue
            if ($check) { $found = $true; break }
        }

        if (-not $found) { return $alias }

        $alias = "$($FirstName).$count.$($LastName)"

        if ($alias.Length -gt (30-13)) {
            $alias = Get-ValidAlias "$FirstName$count" $LastName
        }

        $count++
    }
}

